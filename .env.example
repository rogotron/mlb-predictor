# Copy to .env and fill in. .env is gitignored.

# Where to cache raw API pulls (default: ./data/raw)
DATA_DIR=./data

# Where to write trained model artifacts (default: ./models)
MODEL_DIR=./models

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: NWS user-agent (NWS asks for a contact string per their TOS)
NWS_USER_AGENT="mlb-predictor (your-email@example.com)"
